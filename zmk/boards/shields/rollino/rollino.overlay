/*
 * Rollino: two PMW3610 sensors on the XIAO's SPI bus, combined into pointer
 * motion and twist scrolling by rollino,ball-fusion.
 *
 * XIAO pins:
 *   D8  (P1.13)  SPI SCK            both sensors' SCLK
 *   D10 (P1.15)  SPI MOSI + MISO    both sensors' SDIO (3-wire: same pin)
 *   D7  (P1.12)  CS right sensor    NCS
 *   D6  (P1.11)  CS left sensor     NCS
 *   D3  (P0.29)  right sensor MOTION
 *   D2  (P0.28)  left sensor MOTION
 *   D0, D1, D9   optional buttons (left, right, middle click), to GND
 *   D4, D5       free
 */

#include <zephyr/dt-bindings/input/input-event-codes.h>

&pinctrl {
    spi2_default: spi2_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
                <NRF_PSEL(SPIM_MOSI, 1, 15)>,
                <NRF_PSEL(SPIM_MISO, 1, 15)>;
        };
    };

    spi2_sleep: spi2_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
                <NRF_PSEL(SPIM_MOSI, 1, 15)>,
                <NRF_PSEL(SPIM_MISO, 1, 15)>;
            low-power-enable;
        };
    };
};

&xiao_spi {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi2_default>;
    pinctrl-1 = <&spi2_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&xiao_d 7 GPIO_ACTIVE_LOW>, <&xiao_d 6 GPIO_ACTIVE_LOW>;

    sensor_right: sensor@0 {
        compatible = "pixart,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        motion-gpios = <&xiao_d 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        zephyr,axis-x = <INPUT_REL_X>;
        zephyr,axis-y = <INPUT_REL_Y>;
        res-cpi = <800>;
        smart-mode;
    };

    sensor_left: sensor@1 {
        compatible = "pixart,pmw3610";
        reg = <1>;
        spi-max-frequency = <2000000>;
        motion-gpios = <&xiao_d 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        zephyr,axis-x = <INPUT_REL_X>;
        zephyr,axis-y = <INPUT_REL_Y>;
        res-cpi = <800>;
        smart-mode;
    };
};

/ {
    chosen {
        zmk,kscan = &kscan0;
    };

    /* optional buttons; with none fitted the pins just idle high */
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        input-gpios
            = <&xiao_d 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&xiao_d 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&xiao_d 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            ;
    };

    /* sensor positions as in case/rollino.scad (its console echo prints
     * them): azimuth from the front, positive to the right, and elevation
     * above the ball's equator, in millidegrees */
    ball: ball_fusion {
        compatible = "rollino,ball-fusion";
        pointer-scale = <100>;
        scroll-divisor = <40>;
        twist-ratio = <150>;

        right {
            device = <&sensor_right>;
            azimuth = <129007>;
            elevation = <(-24500)>;
            rotation = <0>;
        };

        left {
            device = <&sensor_left>;
            azimuth = <(-129007)>;
            elevation = <(-24500)>;
            rotation = <0>;
        };
    };

    ball_listener {
        compatible = "zmk,input-listener";
        device = <&ball>;
    };
};
